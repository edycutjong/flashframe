# ClickHouse
# Credentials for your ClickHouse Cloud instance or local setup.
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password-here
# Optional: Defaults to "flashframe" when unset.
CLICKHOUSE_DATABASE=flashframe

# Gemini
# API keys can be obtained from https://aistudio.google.com/apikey
# Use GEMINI_API_KEY for a single key.
GEMINI_API_KEY=your-api-key-here
# OR use GEMINI_API_KEYS for automatic key rotation on 429 / RESOURCE_EXHAUSTED.
# (Comma-separated list of keys; an alternative to GEMINI_API_KEY, not both required)
# GEMINI_API_KEYS=key1,key2,key3
# Optional: Overrides the default model.
# GEMINI_MODEL=gemini-3.6-flash
